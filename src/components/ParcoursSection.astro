---
// SECTION "PARCOURS D'ACCOMPAGNEMENT"
// Version épurée et légère de votre bannière d'origine.
const etapes = [
  { icone: '📍', label: 'Situation actuelle' },
  { icone: '💬', label: 'Premier échange offert', note: 'sans engagement' },
  { icone: '🧭', label: 'Bilan de compétences' },
  { icone: '🔄', label: 'Transition professionnelle' },
  { icone: '🎓', label: 'Formation si besoin' },
  { icone: '🌱', label: 'Nouveau projet' },
];
---
<section class="parcours">
  <div class="conteneur">
    <p class="parcours__sur-titre">25 ans d'expérience dans l'accompagnement des parcours professionnels</p>
    <h2>Votre parcours d'accompagnement</h2>
    <p class="parcours__intro">Un accompagnement humain, structuré et personnalisé, étape après étape.</p>

    <ol class="parcours__etapes">
      {etapes.map((e) => (
        <li class="parcours__etape">
          <span class="parcours__icone">{e.icone}</span>
          <span class="parcours__label">{e.label}</span>
          {e.note && <span class="parcours__note">{e.note}</span>}
        </li>
      ))}
    </ol>

    <ul class="parcours__valeurs">
      <li>🛡️ Confidentialité et respect</li>
      <li>💚 Approche inclusive et adaptée à vos besoins</li>
    </ul>
  </div>
</section>

<style>
  .parcours { background: var(--vert-sauge); color: #fff; padding: 3.5rem 0; }
  .parcours h2 { color: #fff; margin: 0.3rem 0 0.5rem; }
  .parcours__sur-titre { text-transform: uppercase; letter-spacing: 1px; font-size: 0.85rem; font-weight: 600; color: rgba(255,255,255,0.85); margin: 0; }
  .parcours__intro { color: rgba(255,255,255,0.92); font-style: italic; margin-top: 0; }

  .parcours__etapes {
    list-style: none; margin: 2rem 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: stretch;
  }
  .parcours__etape {
    flex: 1 1 150px;
    background: rgba(255,255,255,0.14);
    border-radius: var(--rayon);
    padding: 1rem 0.8rem;
    text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 0.25rem;
    position: relative;
  }
  /* Flèche entre les étapes (masquée sur mobile) */
  .parcours__etape:not(:last-child)::after {
    content: '→';
    position: absolute; right: -0.7rem; top: 50%; transform: translateY(-50%);
    color: rgba(255,255,255,0.8); font-weight: 700; z-index: 1;
  }
  .parcours__icone { font-size: 1.5rem; }
  .parcours__label { font-weight: 600; font-size: 0.95rem; line-height: 1.3; }
  .parcours__note { font-size: 0.78rem; color: rgba(255,255,255,0.85); font-style: italic; }

  .parcours__valeurs {
    list-style: none; margin: 2rem 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 1.5rem;
    font-weight: 600; color: rgba(255,255,255,0.95);
  }

  @media (max-width: 760px) {
    .parcours__etape:not(:last-child)::after { display: none; }
  }
</style>
