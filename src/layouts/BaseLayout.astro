---
// Gabarit de base : structure commune à toutes les pages
// (en-tête HTML, header, contenu, footer).
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { titre, description } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/logo-qualioexpert.png" />
    <!-- Police "Poppins" pour le logo (aspect arrondi de la marque) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&display=swap" rel="stylesheet" />
    <!-- TODO : balises Open Graph (aperçu lors du partage sur les réseaux sociaux) -->
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
