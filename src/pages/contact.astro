---
// PAGE CONTACT : formulaire + prise de rendez-vous
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---
<BaseLayout
  titre="Contact — QualioExpert"
  description="Réservez votre premier échange offert (30 min, sans engagement) ou écrivez à Sonia Briet."
>
  <section class="section">
    <div class="conteneur">
      <h1>Et si nous faisions le point ensemble ?</h1>
      <p class="intro">
        Un premier échange gratuit et sans engagement pour voir comment je peux
        vous accompagner. ⏱ 30 minutes, sans engagement.
      </p>
      <ul class="contact-infos">
        <li>📧 <a href="mailto:qualioexpert@gmail.com">qualioexpert@gmail.com</a></li>
        <li>✆ <a href="tel:+33616687383">06 16 68 73 83</a></li>
      </ul>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="conteneur contact">
      <div>
        <h2>M'écrire</h2>
        <p>Une question, une situation à partager ? Écrivez-moi, je vous réponds personnellement.</p>
        <ContactForm />
      </div>

      <div class="contact__rdv">
        <h2>Réserver un échange offert</h2>
        <p>Choisissez directement le créneau qui vous convient :</p>
        <div
          class="calendly-inline-widget"
          data-url="https://calendly.com/qualioexpert/30min"
          style="min-width:320px;height:630px;"
        ></div>
        <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  @media (max-width: 820px) { .contact { grid-template-columns: 1fr; } }
  .contact-infos { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: 1.5rem; font-weight: 600; }
  .contact-infos a { color: var(--vert-cta-hover); }
</style>
